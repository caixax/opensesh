# Normalize line endings: LF in the repository and in working trees.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets.
*.png binary
*.ico binary
*.ttf binary
*.otf binary
*.woff2 binary
*.tgz binary

# Importer fixtures keep the bytes other programs write (CRLF, Windows-1252, UTF-16).
crates/opensesh-import/tests/fixtures/** -text
